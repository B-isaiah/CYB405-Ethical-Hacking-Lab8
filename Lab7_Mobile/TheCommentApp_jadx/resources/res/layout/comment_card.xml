<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/curve_white_no_border"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="20sp"
        android:textColor="#000"
        android:gravity="center_vertical"
        android:id="@+id/commentMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="On Shot!! Nice Bro."
        android:fontFamily="@font/josefinsans"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#85929e"
        android:gravity="center_vertical"
        android:id="@+id/commentBy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="by, @chaitanya.deshp"
        android:fontFamily="@font/josefinsans"/>
</LinearLayout>
