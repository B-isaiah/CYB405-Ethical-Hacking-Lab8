<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <fr.castorflex.android.smoothprogressbar.SmoothProgressBar
        android:id="@+id/progress_horizontal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:spb_color="@color/colorPrimaryDark"
        app:spb_mirror_mode="false"
        app:spb_progressiveStart_activated="true"
        app:spb_progressiveStart_speed="1.5"
        app:spb_progressiveStop_speed="4"
        app:spb_reversed="false"
        app:spb_sections_count="3"
        app:spb_speed="2"
        app:spb_stroke_separator_length="4dp"
        app:spb_stroke_width="4dp"/>
    <RelativeLayout
        android:padding="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/progress_horizontal">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/top_img"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:src="@drawable/ic_shop_front"/>
        <TextView
            android:textSize="28sp"
            android:textColor="#413e66"
            android:id="@+id/introText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Best in class social media"
            android:maxLines="1"
            android:layout_below="@+id/top_img"
            android:fontFamily="@font/josefinsansitalic"/>
        <TextView
            android:textSize="22sp"
            android:textColor="#413e66"
            android:id="@+id/introText2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="now over cloud."
            android:layout_below="@+id/introText"
            android:fontFamily="@font/josefinsansitalic"/>
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/userName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="User ID"
            android:layout_below="@+id/introText2"
            android:inputType="textVisiblePassword"
            android:fontFamily="@font/josefinsansregular"/>
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:hint="Password"
            android:layout_below="@+id/userName"
            android:inputType="textPassword"
            android:fontFamily="@font/josefinsansregular"/>
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/displayName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:hint="Display Name"
            android:layout_below="@+id/password"
            android:fontFamily="@font/josefinsansregular"/>
        <Button
            android:textSize="20sp"
            android:textColor="#fff"
            android:id="@+id/loginButton"
            android:background="@drawable/round_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Register"
            android:layout_alignParentBottom="true"
            android:textAllCaps="false"
            android:fontFamily="@font/josefinsansregular"/>
    </RelativeLayout>
</RelativeLayout>
